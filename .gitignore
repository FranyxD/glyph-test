local.properties

# Archivos de claves, contraseñas y claves de firma
key.properties
secrets.properties
signing.properties
*.jks
*.keystore
*.pepk

# Archivos de servicios externos (Firebase, etc.)
google-services.json
GoogleService-Info.plist

